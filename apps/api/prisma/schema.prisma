generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Fica em apps/api/data (volume do Docker), fora da pasta do schema: se o
  // volume cobrisse prisma/, ele esconderia o schema.prisma novo a cada update.
  url      = "file:../data/dev.db"
}

model Settings {
  id          Int      @id @default(1)
  
  // --- LLM Providers ---
  openai_key        String?   // OpenAI (GPT-4o, etc)
  openai_model      String?   @default("gpt-4o")
  openai_base_url   String?   @default("https://api.openai.com/v1")
  
  ollama_url        String?   @default("http://localhost:11434")
  ollama_model      String?   @default("llama3")
  
  openrouter_key    String?   // OpenRouter.ai
  openrouter_model  String?   @default("openai/gpt-4o")
  
  google_key        String?   // Google Gemini API
  google_model      String?   @default("gemini-2.0-flash")
  
  active_llm        String    @default("openai") // 'openai' | 'ollama' | 'openrouter' | 'google'
  
  // --- Image Providers ---
  pexels_key        String?   // Pexels Stock Images
  comfyui_url       String?   @default("http://localhost:8188")
  comfyui_workflow  String?   // JSON do workflow ComfyUI
  gemini_img_key    String?   // Google Gemini Image Generation
  gemini_img_model  String?   @default("gemini-2.5-flash-image")
  openrouter_img_model String? @default("google/gemini-3.1-flash-image") // usa a openrouter_key

  active_image      String    @default("pexels") // provedor de imagens GERADAS POR IA: 'openrouter' | 'gemini' | 'comfyui' (o Pexels é o banco de fotos)
  
  // --- OpenWebUI (busca das imagens anexadas no chat) ---
  openwebui_url     String?   // ex: http://host.docker.internal:8080
  openwebui_api_key String?   // API key de um usuário admin do OpenWebUI

  // --- Engine ---
  max_retries       Int       @default(3)
  vision_enabled    Boolean   @default(true)  // LLM lê as imagens para decidir onde usá-las
  visual_review     Boolean   @default(false) // crítica visual por screenshot (mais lenta)
  
  updatedAt         DateTime  @updatedAt
}

model DocumentJob {
  id           String   @id @default(uuid())
  status       String   // 'queued', 'processing', 'completed', 'failed'
  current_step String?  // 'Gerando Design (1/3)', 'Revisão QA (2/3)', etc.
  prompt       String
  file_type    String   // 'PDF', 'PPTX', 'DOCX', 'XLSX'
  images       String?  // JSON de ImageAsset[] (imagens enviadas pelo usuário)
  mode         String   @default("auto") // 'auto' | 'literal' | 'criativo'
  detail_level String?  // 'simples' | 'avancado'
  image_source String?  // 'nenhuma' | 'enviadas' | 'banco' | 'ia'
  extra_images Int      @default(0) // quantas imagens buscar/gerar além das enviadas
  file_url     String?
  error_log    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
